[Unit]
Description=Netra Unified Connectivity and Audio Daemon
After=network.target dbus.service NetworkManager.service
Wants=network.target NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/netra-daemon
Restart=always
RestartSec=3

CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
